# ==============================================================================
# Variables de Entorno para Producción en Dokploy (VPS)
# ==============================================================================

# URL Pública de la Aplicación (Dominio asignado en Dokploy con SSL/HTTPS)
APP_URL=https://contactos.tudominio.com
PORT=3000
NODE_ENV=production

# Orígenes Permitidos por CORS (Separados por coma)
ALLOWED_ORIGINS=https://contactos.tudominio.com,capacitor://localhost,http://localhost:3000

# Base de Datos PostgreSQL
# Si usas docker-compose en Dokploy:
DB_HOST=postgres_db
# Si usas una base de datos gestionada desde la sección 'Databases' de Dokploy:
# DB_HOST=nexus-postgres
DB_PORT=5432
DB_NAME=bd_contacto
DB_USER=postgres
DB_PASSWORD=CambiarPorClaveSeguraPostgres2026!

# Clave Secreta JWT (Genera una cadena larga aleatoria)
JWT_SECRET=generar_clave_hex_aleatoria_super_secreta_contactos_2026

# Configuración de Correo SMTP (Gmail / Servidor Propio)
# Para Gmail: Activar Verificación en 2 pasos y generar "Contraseña de Aplicación"
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=tucorreo@gmail.com
EMAIL_PASS=contrasena_de_aplicacion_16_caracteres
EMAIL_FROM="Nexus Contactos <tucorreo@gmail.com>"
